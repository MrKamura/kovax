  "scripts": {
    "build": "tsup",
    "build:sourcemap": "tsup --sourcemap",
    "dev": "tsup --watch",
    "dev:playground": "npm run dev -w kovax-playground",
    "build:playground": "npm run build -w kovax-playground",
    "dev:storybook": "yarn --cwd apps/storybook dev",
    "build:storybook": "yarn --cwd apps/storybook build",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
