{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "kovax-react": ["../../src/index.ts"],
      "kovax-react/react-hook-form": ["../../src/entries/react-hook-form.ts"],
      "kovax-react/tanstack-form": ["../../src/entries/tanstack-form.ts"]
    }
  },
  "include": ["src", "scripts"]
}
